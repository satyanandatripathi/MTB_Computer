{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_BUILD_SKIP_LOCKFILE_CHECK": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "env": {
        "EAS_BUILD_SKIP_LOCKFILE_CHECK": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
